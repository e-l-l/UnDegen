# Supabase — copy to .env and fill in (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
SUPABASE_SERVICE_ROLE_KEY=<service role secret — server only, never ship to frontend>

# CORS (JSON array). Add your Vercel URL in prod.
ALLOWED_ORIGINS=["http://localhost:5173"]
